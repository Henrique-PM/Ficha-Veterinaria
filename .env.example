# ─────────────────────────────────────────────────────────────
#  Copie para .env (local) ou cole em Vercel → Settings → Environment Variables
#  NUNCA commite o .env de verdade.
# ─────────────────────────────────────────────────────────────

# Porta do servidor local (a Vercel ignora isso)
PORT=5001

# Segredo da sessão. Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_isto_por_um_valor_aleatorio_longo

# Banco de dados (Turso / libSQL)
#   Local  → deixe em branco, usa o arquivo ./data/local.db
#   Vercel → obrigatório, pegue em https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Código de convite para criar conta de VETERINÁRIO.
# Sem isso, o cadastro público só cria conta de visualizador.
# Gere um valor aleatório e passe só para a equipe clínica.
VET_INVITE_CODE=

# Ambiente
NODE_ENV=development
