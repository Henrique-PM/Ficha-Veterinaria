<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <div class="titles">
            <h1>Nossos animais</h1>
            <div class="subtitle">{{total}} {{#if (eq total 1)}}animal{{else}}animais{{/if}} para conhecer</div>
        </div>
    </div>
</div>

<div class="card">
    <form method="GET" action="/user/dashboard" class="filters">
        <div class="field">
            <label for="q">Buscar</label>
            <input type="search" id="q" name="q" value="{{search}}" placeholder="Nome ou raça">
        </div>
        <div class="field">
            <label for="especie">Espécie</label>
            <select id="especie" name="especie" data-autosubmit>
                <option value="">Todas</option>
                {{#each especies}}
                <option value="{{this.species}}" {{selected this.species ../species}}>{{this.species}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <div class="row-tight">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a href="/user/dashboard" class="btn btn-ghost">Limpar</a>
            </div>
        </div>
    </form>
</div>

{{#if animals.length}}
<div class="grid">
    {{#each animals}}
        {{> animal-card animal=this href=(concat "/user/animal/" this.id)}}
    {{/each}}
</div>
{{else}}
<div class="card">
    <div class="empty">
        <span class="emoji" aria-hidden="true">🐾</span>
        <p>Nenhum animal encontrado com esses filtros.</p>
    </div>
</div>
{{/if}}
