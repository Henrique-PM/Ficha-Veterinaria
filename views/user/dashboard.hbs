<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles">
            <h1>Nossos animais</h1>
            <div class="subtitle">{{total}} {{#if (eq total 1)}}animal{{else}}animais{{/if}} para conhecer</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>{{icon "filter"}} Filtros</h2>
        <a href="/user/dashboard" class="btn btn-quiet btn-sm">Limpar</a>
    </div>
    <form method="GET" action="/user/dashboard" class="filters">
        <div class="field">
            <label for="q">Buscar</label>
            <div class="search-field">
                {{icon "search"}}
                <input type="search" id="q" name="q" value="{{search}}" placeholder="Nome ou raça">
            </div>
        </div>
        <div class="field">
            <label for="especie">Espécie</label>
            <select id="especie" name="especie" data-autosubmit>
                <option value="">Todas</option>
                {{#each especies}}
                <option value="{{this.species}}" {{selected this.species ../species}}>{{this.species}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="filtrar" class="muted">&nbsp;</label>
            <button type="submit" id="filtrar" class="btn btn-primary">{{icon "filter"}} Filtrar</button>
        </div>
    </form>
</div>

{{#if animals.length}}
<div class="grid">
    {{#each animals}}
        {{> animal-card animal=this href=(concat "/user/animal/" this.id)}}
    {{/each}}
</div>
{{else}}
<div class="card">
    <div class="empty">
        <span class="empty-icon">{{icon "search"}}</span>
        <h2>Nenhum animal encontrado</h2>
        <p>Nenhum animal corresponde a esses filtros.</p>
        <p class="mt"><a href="/user/dashboard" class="btn btn-ghost">Limpar filtros</a></p>
    </div>
</div>
{{/if}}
