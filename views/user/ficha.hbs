<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <a href="/user/dashboard" class="btn btn-ghost btn-sm">← Voltar</a>
        <div class="titles">
            <h1>{{animal.name}}</h1>
            <div class="subtitle">
                {{speciesIcon animal.species}} {{animal.species}}
                {{#if animal.breed}} · {{animal.breed}}{{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <span class="badge badge-{{statusVariant animal.status}}">{{statusLabel animal.status}}</span>
    </div>
</div>

<div class="profile">
    <div class="profile-photo" id="foto-principal"
         {{#if animal.has_photo}}style="background-image:url('/media/animal/{{animal.id}}/photo')"{{/if}}>
        {{#unless animal.has_photo}}<span aria-hidden="true">{{speciesIcon animal.species}}</span>{{/unless}}
    </div>

    <div class="card" style="margin:0">
        <div class="card-head"><h2>Sobre o {{animal.name}}</h2></div>

        <div class="data-list">
            <div class="data-item"><div class="k">Espécie</div><div class="v">{{animal.species}}</div></div>
            <div class="data-item"><div class="k">Raça</div><div class="v">{{#if animal.breed}}{{animal.breed}}{{else}}SRD{{/if}}</div></div>
            <div class="data-item"><div class="k">Idade</div><div class="v">{{displayAge animal}}</div></div>
            <div class="data-item"><div class="k">Sexo</div><div class="v">{{#if animal.sex}}{{animal.sex}}{{else}}—{{/if}}</div></div>
            <div class="data-item"><div class="k">Porte</div><div class="v">{{#if animal.size}}{{animal.size}}{{else}}—{{/if}}</div></div>
            <div class="data-item">
                <div class="k">Castrado</div>
                <div class="v">{{#if animal.neutered}}Sim{{else}}Não{{/if}}</div>
            </div>
            {{#if animal.environment_name}}
            <div class="data-item">
                <div class="k">Onde está</div>
                <div class="v">{{kindIcon animal.environment_kind}} {{animal.environment_name}}</div>
            </div>
            {{/if}}
            <div class="data-item"><div class="k">Aqui desde</div><div class="v">{{formatDate animal.entry_date}}</div></div>
        </div>

        {{#if animal.characteristics}}
        <div class="mt">
            <div class="k form-label">Características</div>
            <p>{{animal.characteristics}}</p>
        </div>
        {{/if}}

        {{#if animal.description}}
        <div class="mt">
            <div class="k form-label">Histórico e personalidade</div>
            <p>{{animal.description}}</p>
        </div>
        {{/if}}
    </div>
</div>

{{!--
    Esta página não exibe peso, condição corporal, alergias, observações
    clínicas, vacinas, internações, exames, medicamentos, documentos, chip nem
    dados de tutor. Nada disso é sequer carregado do banco em routes/user.js.
--}}
<div class="alert alert-info">
    ℹ️ As informações clínicas do {{animal.name}} (vacinas, exames, tratamentos e prontuário)
    ficam disponíveis apenas para a equipe veterinária.
</div>

<div class="card">
    <div class="card-head">
        <h2>📷 Galeria</h2>
        <button type="button" class="btn btn-primary btn-sm" data-modal-open="foto">+ Enviar foto</button>
    </div>

    {{#if photos.length}}
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
        {{#each photos}}
        <figure class="animal-card">
            <div class="animal-photo" style="background-image:url('/media/photo/{{this.id}}');aspect-ratio:1"></div>
            <figcaption class="animal-body" style="padding:10px">
                <small>{{#if this.description}}{{this.description}}{{else}}Sem descrição{{/if}}</small>
                <small class="muted">{{formatDate this.upload_date}}</small>
            </figcaption>
        </figure>
        {{/each}}
    </div>
    {{else}}
    <div class="empty">
        <span class="emoji" aria-hidden="true">📷</span>
        <p>Nenhuma foto ainda. Que tal enviar a primeira?</p>
    </div>
    {{/if}}
</div>

<dialog id="modal-foto">
    <form method="POST" action="/user/animal/{{animal.id}}/photo" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="modal-head">
            <h2>Enviar foto</h2>
            <button type="button" class="modal-close" data-modal-close aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body">
            <div class="field">
                <label for="photo">Imagem</label>
                <input type="file" id="photo" name="photo" accept="image/*" required>
                <span class="hint">JPG, PNG, WEBP ou GIF. Até 5 MB.</span>
            </div>
            <div class="field">
                <label for="descricao">Descrição (opcional)</label>
                <input type="text" id="descricao" name="description" maxlength="200"
                       placeholder="Ex.: tomando sol na janela">
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">Enviar</button>
        </div>
    </form>
</dialog>
