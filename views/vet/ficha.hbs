<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <a href="/vet/animais" class="btn btn-ghost btn-sm">{{icon "arrowLeft"}} Voltar</a>
        <div class="titles">
            <h1>{{animal.name}}</h1>
            <div class="subtitle">
                {{speciesIcon animal.species}}
                <span>{{animal.species}}{{#if animal.breed}} · {{animal.breed}}{{/if}}</span>
                {{#if animal.environment_name}}
                    <span>·</span>
                    {{kindIcon animal.environment_kind}}
                    <span>{{animal.environment_name}}</span>
                {{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <span class="badge badge-dot badge-{{statusVariant animal.status}}">{{statusLabel animal.status}}</span>
        <a href="/vet/animal/{{animal.id}}/historico" class="btn btn-ghost">{{icon "history"}} Histórico</a>
        <button type="button" class="btn btn-ghost" data-modal-open="status">{{icon "pencil"}} Alterar status</button>
    </div>
</div>

{{#if ok}}
<div class="alert alert-success" role="status">
    {{icon "checkCircle"}}<span class="alert-body">{{ok}}</span>
</div>
{{/if}}

{{#if erro}}
<div class="alert alert-danger" role="alert">
    {{icon "alert"}}
    <span class="alert-body">
        {{#if (eq erro 'chip')}}Já existe outro animal com esse número de chip.
        {{else if (eq erro 'obrigatorios')}}Nome e espécie são obrigatórios.
        {{else if (eq erro 'foto')}}Selecione uma imagem antes de enviar.
        {{else if (eq erro 'destino')}}Escolha um animal de destino válido para a foto.
        {{else}}Não foi possível salvar. Confira os campos obrigatórios e tente de novo.{{/if}}
    </span>
</div>
{{/if}}

{{#if internacaoAberta}}
<div class="alert alert-warning">
    {{icon "hospital"}}
    <span class="alert-body">
        <strong>Internação em aberto</strong> desde {{formatDate internacaoAberta.entry_date}} —
        {{internacaoAberta.reason}}.
    </span>
    <button type="button" class="btn btn-primary btn-sm" data-modal-open="alta">Dar alta</button>
</div>
{{/if}}

<div class="profile">
    <div>
        <div class="profile-photo" id="preview-foto"
             {{#if animal.has_photo}}style="background-image:url('/media/animal/{{animal.id}}/photo')"{{/if}}>
            {{#unless animal.has_photo}}{{speciesIcon animal.species}}{{/unless}}
        </div>
        <form action="/vet/animal/{{animal.id}}/photo" method="POST" enctype="multipart/form-data" class="mt">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="file" name="photo" accept="image/*" required data-preview="preview-foto"
                   aria-label="Nova foto principal">
            <button type="submit" class="btn btn-ghost btn-sm btn-block mt">{{icon "camera"}} Trocar foto</button>
        </form>

        <div class="card mt">
            <div class="card-head"><h3>{{icon "shieldCheck"}} Resumo sanitário</h3></div>
            <div class="summary-list">
                <div class="summary-row">
                    <span class="k">{{icon "scissors"}} Castrado</span>
                    {{#if animal.neutered}}
                        <span class="badge badge-success badge-dot">Sim</span>
                    {{else}}
                        <span class="badge badge-warning badge-dot">Não</span>
                    {{/if}}
                </div>
                <div class="summary-row">
                    <span class="k">{{icon "dna"}} FIV</span>
                    <span class="badge badge-dot badge-{{retroVariant animal.fiv_status}}">{{retroLabel animal.fiv_status}}</span>
                </div>
                <div class="summary-row">
                    <span class="k">{{icon "dna"}} FeLV</span>
                    <span class="badge badge-dot badge-{{retroVariant animal.felv_status}}">{{retroLabel animal.felv_status}}</span>
                </div>
                {{#if healthRecord}}
                <div class="summary-row">
                    <span class="k">{{icon "heartbeat"}} Último peso</span>
                    <strong>{{#if healthRecord.weight}}{{healthRecord.weight}} kg{{else}}—{{/if}}</strong>
                </div>
                {{/if}}
                {{#if animal.chip_number}}
                <div class="summary-row">
                    <span class="k">{{icon "file"}} Chip</span>
                    <span class="mono">{{animal.chip_number}}</span>
                </div>
                {{/if}}
            </div>
        </div>
    </div>

    <div class="card" style="margin:0">
        <div class="card-head">
            <h2>{{icon "clipboard"}} Dados do animal</h2>
            <span class="section-note">Campos com <span class="req">*</span> são obrigatórios</span>
        </div>

        <form method="POST" action="/vet/animal/{{animal.id}}/info">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">

            <div class="form-row">
                <div class="field">
                    <label for="name">Nome <span class="req">*</span></label>
                    <input type="text" id="name" name="name" value="{{animal.name}}" required maxlength="80">
                </div>
                <div class="field">
                    <label for="species">Espécie <span class="req">*</span></label>
                    <input type="text" id="species" name="species" value="{{animal.species}}" required maxlength="40">
                </div>
                <div class="field">
                    <label for="breed">Raça</label>
                    <input type="text" id="breed" name="breed" value="{{animal.breed}}" maxlength="60">
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="birth_date">Nascimento</label>
                    <input type="date" id="birth_date" name="birth_date" value="{{dateInput animal.birth_date}}">
                </div>
                <div class="field">
                    <label for="age">Idade aprox. (anos)</label>
                    <input type="number" id="age" name="age" value="{{animal.age}}" min="0" max="60">
                </div>
                <div class="field">
                    <label for="sex">Sexo</label>
                    <select id="sex" name="sex">
                        <option value="">—</option>
                        {{#each sexes}}
                        <option value="{{this}}" {{selected this ../animal.sex}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="size">Porte</label>
                    <select id="size" name="size">
                        <option value="">—</option>
                        {{#each sizes}}
                        <option value="{{this}}" {{selected this ../animal.size}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="chip_number">Chip</label>
                    <input type="text" id="chip_number" name="chip_number" value="{{animal.chip_number}}" maxlength="60">
                </div>
                <div class="field">
                    <label for="environment_id">Ambiente</label>
                    <select id="environment_id" name="environment_id">
                        <option value="">Sem ambiente</option>
                        {{#each environments}}
                        <option value="{{this.id}}" {{selected this.id ../animal.environment_id}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="neutered_date">Data da castração</label>
                    <input type="date" id="neutered_date" name="neutered_date" value="{{dateInput animal.neutered_date}}">
                    <label class="check check-under">
                        <input type="checkbox" name="neutered" value="1" {{checked animal.neutered}}> Castrado
                    </label>
                </div>
                <div class="field">
                    <label for="fiv_status">FIV</label>
                    <select id="fiv_status" name="fiv_status">
                        {{#each retro}}
                        <option value="{{this}}" {{selected this ../animal.fiv_status}}>{{retroLabel this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="felv_status">FeLV</label>
                    <select id="felv_status" name="felv_status">
                        {{#each retro}}
                        <option value="{{this}}" {{selected this ../animal.felv_status}}>{{retroLabel this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="retro_test_date">Data do teste</label>
                    <input type="date" id="retro_test_date" name="retro_test_date"
                           value="{{dateInput animal.retro_test_date}}">
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="tutor_name">Tutor / adotante</label>
                    <input type="text" id="tutor_name" name="tutor_name" value="{{animal.tutor_name}}" maxlength="120">
                </div>
                <div class="field">
                    <label for="tutor_contact">Contato do tutor</label>
                    <input type="text" id="tutor_contact" name="tutor_contact" value="{{animal.tutor_contact}}" maxlength="120">
                </div>
            </div>

            <div class="field">
                <label for="characteristics">Características</label>
                <textarea id="characteristics" name="characteristics" maxlength="1000">{{animal.characteristics}}</textarea>
            </div>

            <div class="field">
                <label for="description">Histórico e comportamento</label>
                <textarea id="description" name="description" maxlength="2000">{{animal.description}}</textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">{{icon "check"}} Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

<div class="tabs" role="tablist" data-tabs="ficha">
    <button type="button" class="tab" role="tab" data-tab="saude">
        {{icon "heartbeat"}} Saúde <span class="pill">{{healthRecords.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="vacinas">
        {{icon "syringe"}} Vacinas <span class="pill">{{vaccines.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="vermifugacao">
        {{icon "worm"}} Vermifugação <span class="pill">{{dewormings.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="procedimentos">
        {{icon "microscope"}} Procedimentos <span class="pill">{{procedures.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="internacoes">
        {{icon "hospital"}} Internações <span class="pill">{{hospitalizations.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="medicamentos">
        {{icon "pill"}} Medicamentos <span class="pill">{{medications.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="documentos">
        {{icon "paperclip"}} Documentos <span class="pill">{{documents.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="fotos">
        {{icon "camera"}} Fotos <span class="pill">{{photos.length}}</span>
    </button>
</div>

<!-- Saúde -->
<section class="tab-panel" data-panel="saude" data-tabs-for="ficha" role="tabpanel">
    <div class="card">
        <div class="card-head">
            <h2>{{icon "heartbeat"}} Registros de saúde</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="saude">{{icon "plus"}} Novo registro</button>
        </div>
        {{#if healthRecords.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Data</th><th>Peso</th><th>Condição</th><th>Alergias</th><th>Observações</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each healthRecords}}
                    <tr>
                        <td class="nowrap">{{formatDate this.created_at}}</td>
                        <td class="nowrap">{{#if this.weight}}{{this.weight}} kg{{else}}—{{/if}}</td>
                        <td>{{#if this.body_condition}}{{this.body_condition}}{{else}}—{{/if}}</td>
                        <td>{{#if this.allergies}}{{this.allergies}}{{else}}—{{/if}}</td>
                        <td>{{#if this.observations}}{{this.observations}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/saude/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir este registro de saúde?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "heartbeat"}}</span>
            <h2>Nenhum registro de saúde</h2>
            <p>Peso, condição corporal e alergias aparecem aqui.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Vacinas -->
<section class="tab-panel" data-panel="vacinas" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "syringe"}} Carteira de vacinação</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="vacina">{{icon "plus"}} Registrar vacina</button>
        </div>
        {{#if vaccines.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Vacina</th><th>Aplicação</th><th>Próxima dose</th><th>Situação</th><th>Lote</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each vaccines}}
                    <tr>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.application_date}}</td>
                        <td class="nowrap">{{formatDate this.next_dose}}</td>
                        <td>
                            {{#if this.next_dose}}
                            <span class="badge badge-{{dueVariant this.next_dose}}">{{dueLabel this.next_dose}}</span>
                            {{else}}<span class="muted">—</span>{{/if}}
                        </td>
                        <td>{{#if this.batch}}{{this.batch}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/vacina/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir o registro da vacina {{this.name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "syringe"}}</span>
            <h2>Carteira vazia</h2>
            <p>Nenhuma vacina registrada para este animal.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Vermifugação -->
<section class="tab-panel" data-panel="vermifugacao" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "worm"}} Vermifugação e antiparasitários</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="vermifugo">{{icon "plus"}} Registrar aplicação</button>
        </div>
        {{#if dewormings.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Produto</th><th>Tipo</th><th>Aplicação</th><th>Próxima</th><th>Situação</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each dewormings}}
                    <tr>
                        <td><strong>{{this.product}}</strong>{{#if this.dosage}}<br><small class="muted">{{this.dosage}}</small>{{/if}}</td>
                        <td>{{this.kind}}</td>
                        <td class="nowrap">{{formatDate this.application_date}}</td>
                        <td class="nowrap">{{formatDate this.next_application}}</td>
                        <td>
                            {{#if this.next_application}}
                            <span class="badge badge-{{dueVariant this.next_application}}">{{dueLabel this.next_application}}</span>
                            {{else}}<span class="muted">—</span>{{/if}}
                        </td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/vermifugacao/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir este registro?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "worm"}}</span>
            <h2>Nenhuma aplicação</h2>
            <p>Nenhum vermífugo ou antiparasitário registrado.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Procedimentos -->
<section class="tab-panel" data-panel="procedimentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "microscope"}} Exames e procedimentos</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="procedimento">{{icon "plus"}} Registrar</button>
        </div>
        {{#if procedures.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Procedimento</th><th>Data</th><th>Descrição</th><th>Observações</th><th></th></tr></thead>
                <tbody>
                    {{#each procedures}}
                    <tr>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.procedure_date}}</td>
                        <td>{{#if this.description}}{{this.description}}{{else}}—{{/if}}</td>
                        <td>{{#if this.observations}}{{this.observations}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/procedimento/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir o procedimento {{this.name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "microscope"}}</span>
            <h2>Nenhum procedimento</h2>
            <p>Exames e procedimentos cirúrgicos aparecem aqui.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Internações -->
<section class="tab-panel" data-panel="internacoes" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "hospital"}} Internações</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="internacao">{{icon "plus"}} Registrar internação</button>
        </div>
        {{#if hospitalizations.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Entrada</th><th>Saída</th><th>Motivo</th><th>Diagnóstico</th><th>Tratamento</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each hospitalizations}}
                    <tr>
                        <td class="nowrap">{{formatDate this.entry_date}}</td>
                        <td class="nowrap">
                            {{#if this.exit_date}}
                                {{formatDate this.exit_date}}
                                {{#if this.exit_status}}<br><small class="muted">{{this.exit_status}}</small>{{/if}}
                            {{else}}
                                <span class="badge badge-warning">Em aberto</span>
                            {{/if}}
                        </td>
                        <td>{{this.reason}}</td>
                        <td>{{#if this.diagnosis}}{{this.diagnosis}}{{else}}—{{/if}}</td>
                        <td>{{#if this.treatment}}{{this.treatment}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/internacao/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir esta internação?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "hospital"}}</span>
            <h2>Nenhuma internação</h2>
            <p>Nenhuma entrada em internação registrada.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Medicamentos -->
<section class="tab-panel" data-panel="medicamentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "pill"}} Prescrições</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="receita">{{icon "plus"}} Prescrever</button>
        </div>
        {{#if medications.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Medicamento</th><th>Dosagem</th><th>Frequência</th><th>Período</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each medications}}
                    <tr>
                        <td><strong>{{this.medication_name}}</strong></td>
                        <td>{{this.dosage}}</td>
                        <td>{{this.frequency}}</td>
                        <td class="nowrap">
                            {{formatDate this.start_date}}
                            {{#if this.end_date}} → {{formatDate this.end_date}}{{/if}}
                        </td>
                        <td>
                            {{#if (eq this.status 'ativo')}}
                                <span class="badge badge-success">Ativo</span>
                            {{else}}
                                <span class="badge badge-muted">{{this.status}}</span>
                            {{/if}}
                        </td>
                        <td class="actions-cell">
                            {{#if (eq this.status 'ativo')}}
                            <form method="POST" action="/vet/receita/{{this.id}}/encerrar" class="inline-form"
                                  data-confirm="Encerrar a prescrição de {{this.medication_name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm">Encerrar</button>
                            </form>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "pill"}}</span>
            <h2>Nenhuma prescrição</h2>
            <p>Nenhum medicamento prescrito para este animal.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Documentos -->
<section class="tab-panel" data-panel="documentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "paperclip"}} Documentos e laudos</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="documento">{{icon "plus"}} Anexar</button>
        </div>
        {{#if documents.length}}
        <div class="stack">
            {{#each documents}}
            <div class="file-row">
                <div class="file-info">
                    <span class="file-icon">{{icon "file"}}</span>
                    <span>
                        <strong>{{#if this.description}}{{this.description}}{{else}}{{this.filename}}{{/if}}</strong>
                        <small class="cell-sub">{{this.filename}} · {{formatDate this.upload_date}}</small>
                    </span>
                </div>
                <div class="row-tight">
                    <a href="/media/document/{{this.id}}" class="btn btn-ghost btn-sm">{{icon "download"}} Baixar</a>
                    <form method="POST" action="/vet/registro/documento/{{this.id}}/excluir" class="inline-form"
                          data-confirm="Excluir o documento {{this.filename}}?">
                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                        <button type="submit" class="btn btn-danger btn-sm btn-icon"
                                        title="Excluir" aria-label="Excluir registro">{{icon "trash"}}</button>
                    </form>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "paperclip"}}</span>
            <h2>Nenhum documento</h2>
            <p>Laudos, exames e termos anexados aparecem aqui.</p>
        </div>
        {{/if}}
    </div>
</section>

<!-- Fotos -->
<section class="tab-panel" data-panel="fotos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>{{icon "camera"}} Galeria</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="galeria">{{icon "plus"}} Adicionar foto</button>
        </div>
        {{#if photos.length}}
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
            {{#each photos}}
            <figure class="animal-card">
                <div class="animal-photo" style="background-image:url('/media/photo/{{this.id}}');aspect-ratio:1"></div>
                <figcaption class="animal-body" style="padding:11px;gap:6px">
                    <small>{{#if this.description}}{{this.description}}{{else}}Sem descrição{{/if}}</small>
                    <small class="muted">{{formatDate this.upload_date}}</small>
                    <div class="row-tight" style="margin-top:auto">
                        {{#if @root.isRoot}}
                        {{!-- Um único modal para todas as fotos: quem diz de qual
                              se trata é o botão, via data-photo-*. --}}
                        <button type="button" class="btn btn-ghost btn-sm grow"
                                data-modal-open="mover-foto"
                                data-photo-id="{{this.id}}"
                                data-photo-label="{{#if this.description}}{{this.description}}{{else}}Foto de {{formatDate this.upload_date}}{{/if}}">
                            Mover
                        </button>
                        {{/if}}
                        <form method="POST" action="/vet/registro/foto/{{this.id}}/excluir"
                              class="inline-form grow" data-confirm="Excluir esta foto?">
                            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                            <button type="submit" class="btn btn-danger btn-sm btn-block">Excluir</button>
                        </form>
                    </div>
                </figcaption>
            </figure>
            {{/each}}
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "camera"}}</span>
            <h2>Galeria vazia</h2>
            <p>Nenhuma foto além da principal.</p>
        </div>
        {{/if}}
    </div>
</section>

<div class="card danger-zone">
    <div class="card-head">
        <h2>{{icon "alert"}} Excluir animal</h2>
    </div>
    <div class="row between">
        <p class="muted" style="max-width:60ch">
            Remove <strong>{{animal.name}}</strong> e todo o histórico clínico dele
            {{#if totalRegistros}}
                — {{totalRegistros}} {{#if (eq totalRegistros 1)}}registro{{else}}registros{{/if}}
                entre vacinas, exames, internações, medicamentos, fotos e documentos.
            {{else}}
                (não há nenhum registro clínico associado).
            {{/if}}
            Esta ação não pode ser desfeita.
        </p>
        <form method="POST" action="/vet/animal/{{animal.id}}/excluir"
              data-confirm="Excluir {{animal.name}} definitivamente? {{#if totalRegistros}}Os {{totalRegistros}} registros clínicos dele serão apagados junto. {{/if}}Esta ação não pode ser desfeita.">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="btn btn-danger">{{icon "trash"}} Excluir animal</button>
        </form>
    </div>
</div>

