<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <a href="/vet/animais" class="btn btn-ghost btn-sm">← Voltar</a>
        <div class="titles">
            <h1>{{animal.name}}</h1>
            <div class="subtitle">
                {{speciesIcon animal.species}} {{animal.species}}
                {{#if animal.breed}} · {{animal.breed}}{{/if}}
                {{#if animal.environment_name}} · {{kindIcon animal.environment_kind}} {{animal.environment_name}}{{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <span class="badge badge-{{statusVariant animal.status}}">{{statusLabel animal.status}}</span>
        <a href="/vet/animal/{{animal.id}}/historico" class="btn btn-ghost">🕘 Histórico</a>
        <button type="button" class="btn btn-ghost" data-modal-open="status">Alterar status</button>
    </div>
</div>

{{#if erro}}
<div class="alert alert-danger" role="alert">
    {{#if (eq erro 'chip')}}Já existe outro animal com esse número de chip.
    {{else if (eq erro 'obrigatorios')}}Nome e espécie são obrigatórios.
    {{else}}Não foi possível salvar. Confira os campos obrigatórios e tente de novo.{{/if}}
</div>
{{/if}}

{{#if internacaoAberta}}
<div class="alert alert-warning">
    🏥 <strong>Internação em aberto</strong> desde {{formatDate internacaoAberta.entry_date}} —
    {{internacaoAberta.reason}}.
    <button type="button" class="btn btn-primary btn-sm" data-modal-open="alta">Dar alta</button>
</div>
{{/if}}

<div class="profile">
    <div>
        <div class="profile-photo" id="preview-foto"
             {{#if animal.has_photo}}style="background-image:url('/media/animal/{{animal.id}}/photo')"{{/if}}>
            {{#unless animal.has_photo}}<span aria-hidden="true">{{speciesIcon animal.species}}</span>{{/unless}}
        </div>
        <form action="/vet/animal/{{animal.id}}/photo" method="POST" enctype="multipart/form-data" class="mt">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <input type="file" name="photo" accept="image/*" required data-preview="preview-foto">
            <button type="submit" class="btn btn-ghost btn-sm btn-block mt">Trocar foto</button>
        </form>

        <div class="card mt">
            <h3>Resumo sanitário</h3>
            <div class="stack" style="margin-top:12px">
                <div class="row between">
                    <span class="muted">Castrado</span>
                    {{#if animal.neutered}}
                        <span class="badge badge-success">Sim</span>
                    {{else}}
                        <span class="badge badge-warning">Não</span>
                    {{/if}}
                </div>
                <div class="row between">
                    <span class="muted">FIV</span>
                    <span class="badge badge-{{retroVariant animal.fiv_status}}">{{retroLabel animal.fiv_status}}</span>
                </div>
                <div class="row between">
                    <span class="muted">FeLV</span>
                    <span class="badge badge-{{retroVariant animal.felv_status}}">{{retroLabel animal.felv_status}}</span>
                </div>
                {{#if healthRecord}}
                <div class="row between">
                    <span class="muted">Último peso</span>
                    <strong>{{#if healthRecord.weight}}{{healthRecord.weight}} kg{{else}}—{{/if}}</strong>
                </div>
                {{/if}}
                {{#if animal.chip_number}}
                <div class="row between">
                    <span class="muted">Chip</span>
                    <small>{{animal.chip_number}}</small>
                </div>
                {{/if}}
            </div>
        </div>
    </div>

    <div class="card" style="margin:0">
        <div class="card-head"><h2>📋 Dados do animal</h2></div>

        <form method="POST" action="/vet/animal/{{animal.id}}/info">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">

            <div class="form-row">
                <div class="field">
                    <label for="name">Nome *</label>
                    <input type="text" id="name" name="name" value="{{animal.name}}" required maxlength="80">
                </div>
                <div class="field">
                    <label for="species">Espécie *</label>
                    <input type="text" id="species" name="species" value="{{animal.species}}" required maxlength="40">
                </div>
                <div class="field">
                    <label for="breed">Raça</label>
                    <input type="text" id="breed" name="breed" value="{{animal.breed}}" maxlength="60">
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="birth_date">Nascimento</label>
                    <input type="date" id="birth_date" name="birth_date" value="{{dateInput animal.birth_date}}">
                </div>
                <div class="field">
                    <label for="age">Idade aprox. (anos)</label>
                    <input type="number" id="age" name="age" value="{{animal.age}}" min="0" max="60">
                </div>
                <div class="field">
                    <label for="sex">Sexo</label>
                    <select id="sex" name="sex">
                        <option value="">—</option>
                        {{#each sexes}}
                        <option value="{{this}}" {{selected this ../animal.sex}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="size">Porte</label>
                    <select id="size" name="size">
                        <option value="">—</option>
                        {{#each sizes}}
                        <option value="{{this}}" {{selected this ../animal.size}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="chip_number">Chip</label>
                    <input type="text" id="chip_number" name="chip_number" value="{{animal.chip_number}}" maxlength="60">
                </div>
                <div class="field">
                    <label for="environment_id">Ambiente</label>
                    <select id="environment_id" name="environment_id">
                        <option value="">Sem ambiente</option>
                        {{#each environments}}
                        <option value="{{this.id}}" {{selected this.id ../animal.environment_id}}>
                            {{kindIcon this.kind}} {{this.name}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label class="check">
                        <input type="checkbox" name="neutered" value="1" {{checked animal.neutered}}> Castrado
                    </label>
                    <label for="neutered_date">Data da castração</label>
                    <input type="date" id="neutered_date" name="neutered_date" value="{{dateInput animal.neutered_date}}">
                </div>
                <div class="field">
                    <label for="fiv_status">FIV</label>
                    <select id="fiv_status" name="fiv_status">
                        {{#each retro}}
                        <option value="{{this}}" {{selected this ../animal.fiv_status}}>{{retroLabel this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="felv_status">FeLV</label>
                    <select id="felv_status" name="felv_status">
                        {{#each retro}}
                        <option value="{{this}}" {{selected this ../animal.felv_status}}>{{retroLabel this}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="field">
                    <label for="retro_test_date">Data do teste</label>
                    <input type="date" id="retro_test_date" name="retro_test_date"
                           value="{{dateInput animal.retro_test_date}}">
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label for="tutor_name">Tutor / adotante</label>
                    <input type="text" id="tutor_name" name="tutor_name" value="{{animal.tutor_name}}" maxlength="120">
                </div>
                <div class="field">
                    <label for="tutor_contact">Contato do tutor</label>
                    <input type="text" id="tutor_contact" name="tutor_contact" value="{{animal.tutor_contact}}" maxlength="120">
                </div>
            </div>

            <div class="field">
                <label for="characteristics">Características</label>
                <textarea id="characteristics" name="characteristics" maxlength="1000">{{animal.characteristics}}</textarea>
            </div>

            <div class="field">
                <label for="description">Histórico e comportamento</label>
                <textarea id="description" name="description" maxlength="2000">{{animal.description}}</textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
            </div>
        </form>
    </div>
</div>

<div class="tabs" role="tablist" data-tabs="ficha">
    <button type="button" class="tab" role="tab" data-tab="saude">
        ❤️ Saúde <span class="pill">{{healthRecords.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="vacinas">
        💉 Vacinas <span class="pill">{{vaccines.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="vermifugacao">
        🪱 Vermifugação <span class="pill">{{dewormings.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="procedimentos">
        🔬 Procedimentos <span class="pill">{{procedures.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="internacoes">
        🏥 Internações <span class="pill">{{hospitalizations.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="medicamentos">
        💊 Medicamentos <span class="pill">{{medications.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="documentos">
        📎 Documentos <span class="pill">{{documents.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="fotos">
        📷 Fotos <span class="pill">{{photos.length}}</span>
    </button>
</div>

<!-- Saúde -->
<section class="tab-panel" data-panel="saude" data-tabs-for="ficha" role="tabpanel">
    <div class="card">
        <div class="card-head">
            <h2>Registros de saúde</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="saude">+ Novo registro</button>
        </div>
        {{#if healthRecords.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Data</th><th>Peso</th><th>Condição</th><th>Alergias</th><th>Observações</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each healthRecords}}
                    <tr>
                        <td class="nowrap">{{formatDate this.created_at}}</td>
                        <td class="nowrap">{{#if this.weight}}{{this.weight}} kg{{else}}—{{/if}}</td>
                        <td>{{#if this.body_condition}}{{this.body_condition}}{{else}}—{{/if}}</td>
                        <td>{{#if this.allergies}}{{this.allergies}}{{else}}—{{/if}}</td>
                        <td>{{#if this.observations}}{{this.observations}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/saude/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir este registro de saúde?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">❤️</span><p>Nenhum registro de saúde.</p></div>
        {{/if}}
    </div>
</section>

<!-- Vacinas -->
<section class="tab-panel" data-panel="vacinas" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Carteira de vacinação</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="vacina">+ Registrar vacina</button>
        </div>
        {{#if vaccines.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Vacina</th><th>Aplicação</th><th>Próxima dose</th><th>Situação</th><th>Lote</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each vaccines}}
                    <tr>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.application_date}}</td>
                        <td class="nowrap">{{formatDate this.next_dose}}</td>
                        <td>
                            {{#if this.next_dose}}
                            <span class="badge badge-{{dueVariant this.next_dose}}">{{dueLabel this.next_dose}}</span>
                            {{else}}<span class="muted">—</span>{{/if}}
                        </td>
                        <td>{{#if this.batch}}{{this.batch}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/vacina/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir o registro da vacina {{this.name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">💉</span><p>Nenhuma vacina registrada.</p></div>
        {{/if}}
    </div>
</section>

<!-- Vermifugação -->
<section class="tab-panel" data-panel="vermifugacao" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Vermifugação e antiparasitários</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="vermifugo">+ Registrar aplicação</button>
        </div>
        {{#if dewormings.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Produto</th><th>Tipo</th><th>Aplicação</th><th>Próxima</th><th>Situação</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each dewormings}}
                    <tr>
                        <td><strong>{{this.product}}</strong>{{#if this.dosage}}<br><small class="muted">{{this.dosage}}</small>{{/if}}</td>
                        <td>{{this.kind}}</td>
                        <td class="nowrap">{{formatDate this.application_date}}</td>
                        <td class="nowrap">{{formatDate this.next_application}}</td>
                        <td>
                            {{#if this.next_application}}
                            <span class="badge badge-{{dueVariant this.next_application}}">{{dueLabel this.next_application}}</span>
                            {{else}}<span class="muted">—</span>{{/if}}
                        </td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/vermifugacao/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir este registro?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">🪱</span><p>Nenhuma aplicação registrada.</p></div>
        {{/if}}
    </div>
</section>

<!-- Procedimentos -->
<section class="tab-panel" data-panel="procedimentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Exames e procedimentos</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="procedimento">+ Registrar</button>
        </div>
        {{#if procedures.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Procedimento</th><th>Data</th><th>Descrição</th><th>Observações</th><th></th></tr></thead>
                <tbody>
                    {{#each procedures}}
                    <tr>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.procedure_date}}</td>
                        <td>{{#if this.description}}{{this.description}}{{else}}—{{/if}}</td>
                        <td>{{#if this.observations}}{{this.observations}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/procedimento/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir o procedimento {{this.name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">🔬</span><p>Nenhum procedimento registrado.</p></div>
        {{/if}}
    </div>
</section>

<!-- Internações -->
<section class="tab-panel" data-panel="internacoes" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Internações</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="internacao">+ Registrar internação</button>
        </div>
        {{#if hospitalizations.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Entrada</th><th>Saída</th><th>Motivo</th><th>Diagnóstico</th><th>Tratamento</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each hospitalizations}}
                    <tr>
                        <td class="nowrap">{{formatDate this.entry_date}}</td>
                        <td class="nowrap">
                            {{#if this.exit_date}}
                                {{formatDate this.exit_date}}
                                {{#if this.exit_status}}<br><small class="muted">{{this.exit_status}}</small>{{/if}}
                            {{else}}
                                <span class="badge badge-warning">Em aberto</span>
                            {{/if}}
                        </td>
                        <td>{{this.reason}}</td>
                        <td>{{#if this.diagnosis}}{{this.diagnosis}}{{else}}—{{/if}}</td>
                        <td>{{#if this.treatment}}{{this.treatment}}{{else}}—{{/if}}</td>
                        <td class="actions-cell">
                            <form method="POST" action="/vet/registro/internacao/{{this.id}}/excluir" class="inline-form"
                                  data-confirm="Excluir esta internação?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">🏥</span><p>Nenhuma internação registrada.</p></div>
        {{/if}}
    </div>
</section>

<!-- Medicamentos -->
<section class="tab-panel" data-panel="medicamentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Prescrições</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="receita">+ Prescrever</button>
        </div>
        {{#if medications.length}}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Medicamento</th><th>Dosagem</th><th>Frequência</th><th>Período</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    {{#each medications}}
                    <tr>
                        <td><strong>{{this.medication_name}}</strong></td>
                        <td>{{this.dosage}}</td>
                        <td>{{this.frequency}}</td>
                        <td class="nowrap">
                            {{formatDate this.start_date}}
                            {{#if this.end_date}} → {{formatDate this.end_date}}{{/if}}
                        </td>
                        <td>
                            {{#if (eq this.status 'ativo')}}
                                <span class="badge badge-success">Ativo</span>
                            {{else}}
                                <span class="badge badge-muted">{{this.status}}</span>
                            {{/if}}
                        </td>
                        <td class="actions-cell">
                            {{#if (eq this.status 'ativo')}}
                            <form method="POST" action="/vet/receita/{{this.id}}/encerrar" class="inline-form"
                                  data-confirm="Encerrar a prescrição de {{this.medication_name}}?">
                                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                <button type="submit" class="btn btn-ghost btn-sm">Encerrar</button>
                            </form>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">💊</span><p>Nenhum medicamento prescrito.</p></div>
        {{/if}}
    </div>
</section>

<!-- Documentos -->
<section class="tab-panel" data-panel="documentos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Documentos e laudos</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="documento">+ Anexar</button>
        </div>
        {{#if documents.length}}
        <div class="stack">
            {{#each documents}}
            <div class="row between" style="padding:12px;background:var(--surface-2);border-radius:var(--radius-sm)">
                <div>
                    📎 <strong>{{#if this.description}}{{this.description}}{{else}}{{this.filename}}{{/if}}</strong>
                    <br><small class="muted">{{this.filename}} · {{formatDate this.upload_date}}</small>
                </div>
                <div class="row-tight">
                    <a href="/media/document/{{this.id}}" class="btn btn-ghost btn-sm">Baixar</a>
                    <form method="POST" action="/vet/registro/documento/{{this.id}}/excluir" class="inline-form"
                          data-confirm="Excluir o documento {{this.filename}}?">
                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                        <button type="submit" class="btn btn-ghost btn-sm" title="Excluir">🗑</button>
                    </form>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">📎</span><p>Nenhum documento anexado.</p></div>
        {{/if}}
    </div>
</section>

<!-- Fotos -->
<section class="tab-panel" data-panel="fotos" data-tabs-for="ficha" role="tabpanel" hidden>
    <div class="card">
        <div class="card-head">
            <h2>Galeria</h2>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="galeria">+ Adicionar foto</button>
        </div>
        {{#if photos.length}}
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))">
            {{#each photos}}
            <figure class="animal-card">
                <div class="animal-photo" style="background-image:url('/media/photo/{{this.id}}');aspect-ratio:1"></div>
                <figcaption class="animal-body" style="padding:10px;gap:6px">
                    <small>{{#if this.description}}{{this.description}}{{else}}Sem descrição{{/if}}</small>
                    <small class="muted">{{formatDate this.upload_date}}</small>
                    <form method="POST" action="/vet/registro/foto/{{this.id}}/excluir"
                          data-confirm="Excluir esta foto?">
                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                        <button type="submit" class="btn btn-ghost btn-sm btn-block">Excluir</button>
                    </form>
                </figcaption>
            </figure>
            {{/each}}
        </div>
        {{else}}
        <div class="empty"><span class="emoji" aria-hidden="true">📷</span><p>Nenhuma foto na galeria.</p></div>
        {{/if}}
    </div>
</section>

<!-- ════════════════════ Modais ════════════════════ -->

<dialog id="modal-status">
    <form method="POST" action="/vet/animal/{{animal.id}}/status">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="modal-head">
            <h2>Alterar status</h2>
            <button type="button" class="modal-close" data-modal-close aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body">
            <div class="field">
                <label for="novo-status">Status</label>
                <select id="novo-status" name="status" required>
                    {{#each statuses}}
                    <option value="{{this}}" {{selected this ../animal.status}}>{{statusLabel this}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="hint">
                Ao marcar <strong>Adotado</strong> ou <strong>Falecido</strong>, o animal sai
                automaticamente do ambiente em que está.
            </p>
            <div class="form-row">
                <div class="field">
                    <label for="adoption_date">Data da adoção</label>
                    <input type="date" id="adoption_date" name="adoption_date" value="{{dateInput animal.adoption_date}}">
                </div>
                <div class="field">
                    <label for="st-tutor">Adotante</label>
                    <input type="text" id="st-tutor" name="tutor_name" value="{{animal.tutor_name}}" maxlength="120">
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label for="deceased_date">Data do óbito</label>
                    <input type="date" id="deceased_date" name="deceased_date" value="{{dateInput animal.deceased_date}}">
                </div>
                <div class="field">
                    <label for="deceased_cause">Causa</label>
                    <input type="text" id="deceased_cause" name="deceased_cause" value="{{animal.deceased_cause}}" maxlength="300">
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
        </div>
    </form>
</dialog>

{{#if internacaoAberta}}
<dialog id="modal-alta">
    <form method="POST" action="/vet/internacao/{{internacaoAberta.id}}/alta">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div class="modal-head">
            <h2>Dar alta</h2>
            <button type="button" class="modal-close" data-modal-close aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body">
            <p class="muted" style="margin-bottom:14px">
                Internação de {{formatDate internacaoAberta.entry_date}} — {{internacaoAberta.reason}}
            </p>
            <div class="form-row">
                <div class="field">
                    <label for="exit_date">Data da alta</label>
                    <input type="date" id="exit_date" name="exit_date" data-default-today>
                </div>
                <div class="field">
                    <label for="animal_status">Status após a alta</label>
                    <select id="animal_status" name="animal_status">
                        <option value="abrigo">Abrigo</option>
                        <option value="clinica">Clínica</option>
                        <option value="adotado">Adotado</option>
                        <option value="falecido">Falecido</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label for="exit_status">Condição na alta</label>
                <input type="text" id="exit_status" name="exit_status" maxlength="200"
                       placeholder="Ex.: recuperado, estável, óbito">
            </div>
            <div class="field">
                <label for="alta-obs">Observações finais</label>
                <textarea id="alta-obs" name="observations" maxlength="1000"></textarea>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
            <button type="submit" class="btn btn-primary">Confirmar alta</button>
        </div>
    </form>
</dialog>
{{/if}}

