<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <div class="titles">
            <h1>Relatórios</h1>
            <div class="subtitle">Panorama do abrigo</div>
        </div>
    </div>
</div>

<div class="stats">
    <div class="stat">
        <div class="ico" aria-hidden="true">🐾</div>
        <div class="label">Total de animais</div>
        <div class="value">{{total_animais}}</div>
    </div>
    <div class="stat">
        <div class="ico" aria-hidden="true">❤️</div>
        <div class="label">Adotados</div>
        <div class="value">{{adotados}}</div>
    </div>
    <div class="stat">
        <div class="ico" aria-hidden="true">✂️</div>
        <div class="label">Castrados</div>
        <div class="value">{{castrados}}</div>
    </div>
    <div class="stat">
        <div class="ico" aria-hidden="true">💉</div>
        <div class="label">Vacinas no mês</div>
        <div class="value">{{vacinas_mes}}</div>
    </div>
    <div class="stat">
        <div class="ico" aria-hidden="true">🏥</div>
        <div class="label">Internações no mês</div>
        <div class="value">{{internacoes_mes}}</div>
    </div>
    <div class="stat">
        <div class="ico" aria-hidden="true">🔬</div>
        <div class="label">Procedimentos no mês</div>
        <div class="value">{{procedimentos_mes}}</div>
    </div>
    <div class="stat {{#if fiv_positivos}}is-warn{{/if}}">
        <div class="ico" aria-hidden="true">🧬</div>
        <div class="label">Gatos FIV+</div>
        <div class="value">{{fiv_positivos}}</div>
    </div>
    <div class="stat {{#if felv_positivos}}is-warn{{/if}}">
        <div class="ico" aria-hidden="true">🧬</div>
        <div class="label">Gatos FeLV+</div>
        <div class="value">{{felv_positivos}}</div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>🐾 Animais por espécie</h2>
    </div>
    {{#if porEspecie.length}}
    <div class="bars">
        {{#each porEspecie}}
        <div class="bar-row">
            <span>{{speciesIcon this.species}} {{this.species}}</span>
            <span class="bar-track"><span class="bar-fill" style="width:{{percent this.count ../maxEspecie}}%"></span></span>
            <span class="bar-value">{{this.count}}</span>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="empty">Sem dados.</p>
    {{/if}}
</div>

<div class="card">
    <div class="card-head"><h2>📍 Animais por status</h2></div>
    {{#if porStatus.length}}
    <div class="bars">
        {{#each porStatus}}
        <div class="bar-row">
            <span><span class="badge badge-{{statusVariant this.status}}">{{statusLabel this.status}}</span></span>
            <span class="bar-track"><span class="bar-fill" style="width:{{percent this.count ../maxStatus}}%"></span></span>
            <span class="bar-value">{{this.count}}</span>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="empty">Sem dados.</p>
    {{/if}}
</div>

<div class="card">
    <div class="card-head">
        <h2>🏘️ Ocupação por ambiente</h2>
        <a href="/vet/ambientes" class="btn btn-ghost btn-sm">Gerenciar</a>
    </div>
    {{#if porAmbiente.length}}
    <div class="table-wrap">
        <table>
            <thead><tr><th>Ambiente</th><th>Tipo</th><th>Animais</th><th>Capacidade</th><th>Ocupação</th></tr></thead>
            <tbody>
                {{#each porAmbiente}}
                <tr>
                    <td><strong>{{this.name}}</strong></td>
                    <td>{{kindIcon this.kind}} {{kindLabel this.kind}}</td>
                    <td>{{this.count}}</td>
                    <td>{{#if this.capacity}}{{this.capacity}}{{else}}—{{/if}}</td>
                    <td style="min-width:140px">
                        {{#if this.capacity}}
                        <div class="meter {{#if (gt this.count this.capacity)}}is-full{{/if}}">
                            <span style="width:{{percent this.count this.capacity}}%"></span>
                        </div>
                        <small class="muted">{{percent this.count this.capacity}}%</small>
                        {{else}}
                        <span class="muted">—</span>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="empty">
        <span class="emoji" aria-hidden="true">🏘️</span>
        <p>Nenhum ambiente cadastrado.</p>
    </div>
    {{/if}}
</div>

{{#if estoqueBaixo.length}}
<div class="card">
    <div class="card-head">
        <h2>💊 Medicamentos com estoque baixo</h2>
        <a href="/vet/medicamentos?filtro=baixo" class="btn btn-ghost btn-sm">Repor</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Medicamento</th><th>Estoque</th><th>Mínimo</th></tr></thead>
            <tbody>
                {{#each estoqueBaixo}}
                <tr>
                    <td><strong>{{this.name}}</strong></td>
                    <td><span class="badge badge-danger">{{this.stock_quantity}} {{this.unit}}</span></td>
                    <td>{{this.min_stock_level}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}
