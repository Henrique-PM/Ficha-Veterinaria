<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles">
            <h1>Meus registros</h1>
            <div class="subtitle">Tudo o que foi lançado por {{currentUser.name}}</div>
        </div>
    </div>
</div>

<div class="tabs" role="tablist" data-tabs="registros">
    <button type="button" class="tab" role="tab" data-tab="vacinas">
        {{icon "syringe"}} Vacinas <span class="pill">{{vacinas.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="procedimentos">
        {{icon "microscope"}} Procedimentos <span class="pill">{{procedimentos.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="receitas">
        {{icon "pill"}} Prescrições <span class="pill">{{receitas.length}}</span>
    </button>
    <button type="button" class="tab" role="tab" data-tab="internacoes">
        {{icon "hospital"}} Internações <span class="pill">{{internacoes.length}}</span>
    </button>
</div>

<section class="tab-panel" data-panel="vacinas" data-tabs-for="registros" role="tabpanel">
    <div class="card">
        {{#if vacinas.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Animal</th><th>Vacina</th><th>Aplicação</th><th>Próxima dose</th></tr></thead>
                <tbody>
                    {{#each vacinas}}
                    <tr>
                        <td><a href="/vet/animal/{{this.animal_id}}">{{this.animal_name}}</a></td>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.application_date}}</td>
                        <td class="nowrap">{{formatDate this.next_dose}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "syringe"}}</span>
            <h2>Nenhuma vacina aplicada</h2>
            <p>Você ainda não registrou aplicação de vacina.</p>
        </div>
        {{/if}}
    </div>
</section>

<section class="tab-panel" data-panel="procedimentos" data-tabs-for="registros" role="tabpanel" hidden>
    <div class="card">
        {{#if procedimentos.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Animal</th><th>Procedimento</th><th>Data</th><th>Descrição</th></tr></thead>
                <tbody>
                    {{#each procedimentos}}
                    <tr>
                        <td><a href="/vet/animal/{{this.animal_id}}">{{this.animal_name}}</a></td>
                        <td><strong>{{this.name}}</strong></td>
                        <td class="nowrap">{{formatDate this.procedure_date}}</td>
                        <td>{{#if this.description}}{{truncate this.description 80}}{{else}}—{{/if}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "microscope"}}</span>
            <h2>Nenhum procedimento</h2>
            <p>Nenhum exame ou procedimento registrado por você.</p>
        </div>
        {{/if}}
    </div>
</section>

<section class="tab-panel" data-panel="receitas" data-tabs-for="registros" role="tabpanel" hidden>
    <div class="card">
        {{#if receitas.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Animal</th><th>Medicamento</th><th>Posologia</th><th>Início</th><th>Status</th></tr></thead>
                <tbody>
                    {{#each receitas}}
                    <tr>
                        <td><a href="/vet/animal/{{this.animal_id}}">{{this.animal_name}}</a></td>
                        <td><strong>{{this.medication_name}}</strong></td>
                        <td>{{this.dosage}} · {{this.frequency}}</td>
                        <td class="nowrap">{{formatDate this.start_date}}</td>
                        <td>
                            {{#if (eq this.status 'ativo')}}
                                <span class="badge badge-success">Ativo</span>
                            {{else}}
                                <span class="badge badge-muted">{{this.status}}</span>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "pill"}}</span>
            <h2>Nenhuma prescrição</h2>
            <p>Nenhum medicamento prescrito por você.</p>
        </div>
        {{/if}}
    </div>
</section>

<section class="tab-panel" data-panel="internacoes" data-tabs-for="registros" role="tabpanel" hidden>
    <div class="card">
        {{#if internacoes.length}}
        <div class="table-wrap">
            <table>
                <thead><tr><th>Animal</th><th>Motivo</th><th>Entrada</th><th>Saída</th></tr></thead>
                <tbody>
                    {{#each internacoes}}
                    <tr>
                        <td><a href="/vet/animal/{{this.animal_id}}">{{this.animal_name}}</a></td>
                        <td>{{this.reason}}</td>
                        <td class="nowrap">{{formatDate this.entry_date}}</td>
                        <td class="nowrap">
                            {{#if this.exit_date}}{{formatDate this.exit_date}}
                            {{else}}<span class="badge badge-warning">Em aberto</span>{{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="empty">
            <span class="empty-icon">{{icon "hospital"}}</span>
            <h2>Nenhuma internação</h2>
            <p>Nenhuma internação registrada por você.</p>
        </div>
        {{/if}}
    </div>
</section>
