<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <a href="/vet/animal/{{animal.id}}" class="btn btn-ghost btn-sm">← Ficha</a>
        <div class="titles">
            <h1>Histórico de {{animal.name}}</h1>
            <div class="subtitle">
                {{speciesIcon animal.species}} {{animal.species}} ·
                {{timeline.length}} {{#if (eq timeline.length 1)}}evento{{else}}eventos{{/if}}
            </div>
        </div>
    </div>
</div>

<div class="card">
    {{#if timeline.length}}
    <div class="timeline">
        {{#each timeline}}
        <div class="tl-item">
            <div class="tl-icon" aria-hidden="true">{{this.icon}}</div>
            <div>
                <div class="tl-head">
                    <span class="badge badge-muted">{{this.tipo}}</span>
                    <span class="tl-title">{{this.titulo}}</span>
                    <small class="muted">{{formatDate this.date}}</small>
                </div>
                {{#if this.detalhe}}<div class="tl-detail">{{this.detalhe}}</div>{{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="empty">
        <span class="emoji" aria-hidden="true">🕘</span>
        <p>Nenhum evento registrado para {{animal.name}} ainda.</p>
        <p class="mt"><a href="/vet/animal/{{animal.id}}" class="btn btn-primary">Abrir ficha</a></p>
    </div>
    {{/if}}
</div>
