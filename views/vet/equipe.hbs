<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles">
            <h1>Equipe</h1>
            <div class="subtitle">Quem acessa o quê no sistema</div>
        </div>
    </div>
    <div class="actions">
        <form method="GET" action="/vet/equipe" class="search-field is-wide">
            {{icon "search"}}
            <input type="search" name="q" value="{{search}}" aria-label="Buscar pessoa"
                   placeholder="Buscar por nome ou e-mail">
        </form>
    </div>
</div>

{{#if aviso}}
<div class="alert alert-success" role="status">
    {{icon "checkCircle"}}<span class="alert-body">{{aviso}}</span>
</div>
{{/if}}

<div class="alert alert-info">
    {{icon "info"}}
    <span class="alert-body">
        <strong>Como funciona:</strong> todo cadastro novo entra como <strong>visualizador</strong> —
        ele só vê a apresentação dos animais, nunca o prontuário. Esta tela é exclusiva do
        administrador: só você concede e remove o acesso de veterinário. Quem é veterinário
        não enxerga esta área.
    </span>
</div>

<div class="stats">
    <div class="stat is-primary">
        <span class="stat-icon">{{icon "key"}}</span>
        <span class="stat-body">
            <span class="label">Administradores</span>
            <span class="value">{{totals.admins}}</span>
        </span>
    </div>
    <div class="stat">
        <span class="stat-icon">{{icon "stethoscope"}}</span>
        <span class="stat-body">
            <span class="label">Veterinários</span>
            <span class="value">{{totals.vets}}</span>
        </span>
    </div>
    <div class="stat">
        <span class="stat-icon">{{icon "eye"}}</span>
        <span class="stat-body">
            <span class="label">Visualizadores</span>
            <span class="value">{{totals.viewers}}</span>
        </span>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>{{icon "users"}} Usuários cadastrados</h2>
        <span class="section-note">{{users.length}} {{#if (eq users.length 1)}}pessoa{{else}}pessoas{{/if}}</span>
    </div>

    {{#if users.length}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Pessoa</th>
                    <th>Papel</th>
                    <th>Situação</th>
                    <th>Desde</th>
                    <th class="actions-cell">Ações</th>
                </tr>
            </thead>
            <tbody>
                {{#each users}}
                <tr>
                    <td>
                        <div class="cell-main">
                            <span class="avatar" aria-hidden="true">{{initials this.name}}</span>
                            <span>
                                <strong>{{this.name}}</strong>
                                {{#if (eq this.id ../currentUser.id)}}
                                    <span class="badge badge-primary">você</span>
                                {{/if}}
                                <small class="cell-sub">{{this.email}}</small>
                            </span>
                        </div>
                    </td>
                    <td>
                        {{#if (eq this.type 'admin')}}
                            <span class="badge badge-primary">{{icon "key"}} Administrador</span>
                        {{else if (eq this.type 'veterinario')}}
                            <span class="badge badge-success">{{icon "stethoscope"}} Veterinário</span>
                        {{else}}
                            <span class="badge badge-muted">{{icon "eye"}} Visualizador</span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if this.active}}
                            <span class="badge badge-success badge-dot">Ativo</span>
                        {{else}}
                            <span class="badge badge-danger badge-dot">Desativado</span>
                        {{/if}}
                    </td>
                    <td class="nowrap"><small class="muted">{{formatDate this.created_at}}</small></td>
                    <td class="actions-cell">
                        {{#if (eq this.id ../currentUser.id)}}
                            <small class="muted">—</small>
                        {{else}}
                            <div class="row-tight" style="justify-content:flex-end">
                                {{#if (eq this.type 'visualizador')}}
                                    <form method="POST" action="/vet/equipe/{{this.id}}/papel" class="inline-form"
                                          data-confirm="Promover {{this.name}} a veterinário? Essa pessoa passará a ver todos os prontuários.">
                                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                        <input type="hidden" name="type" value="veterinario">
                                        <button type="submit" class="btn btn-primary btn-sm">Tornar veterinário</button>
                                    </form>
                                {{/if}}

                                {{#if (eq this.type 'veterinario')}}
                                    <form method="POST" action="/vet/equipe/{{this.id}}/papel" class="inline-form"
                                          data-confirm="Rebaixar {{this.name}} a visualizador? Ela perderá acesso aos prontuários agora.">
                                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                        <input type="hidden" name="type" value="visualizador">
                                        <button type="submit" class="btn btn-ghost btn-sm">Rebaixar</button>
                                    </form>
                                    {{#if ../viewerIsAdmin}}
                                        <form method="POST" action="/vet/equipe/{{this.id}}/papel" class="inline-form"
                                              data-confirm="Tornar {{this.name}} administrador? Ela poderá gerenciar toda a equipe.">
                                            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                            <input type="hidden" name="type" value="admin">
                                            <button type="submit" class="btn btn-ghost btn-sm">{{icon "arrowUp"}} Admin</button>
                                        </form>
                                    {{/if}}
                                {{/if}}

                                {{#if (and (eq this.type 'admin') ../viewerIsAdmin)}}
                                    <form method="POST" action="/vet/equipe/{{this.id}}/papel" class="inline-form"
                                          data-confirm="Remover o papel de administrador de {{this.name}}?">
                                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                        <input type="hidden" name="type" value="veterinario">
                                        <button type="submit" class="btn btn-ghost btn-sm">{{icon "arrowDown"}} Veterinário</button>
                                    </form>
                                {{/if}}

                                {{#if ../viewerIsAdmin}}
                                    <button type="button" class="btn btn-ghost btn-sm"
                                            data-modal-open="senha-{{this.id}}">{{icon "lock"}} Senha</button>
                                    <form method="POST" action="/vet/equipe/{{this.id}}/ativo" class="inline-form"
                                          data-confirm="Confirmar alteração de acesso de {{this.name}}?">
                                        <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                        <input type="hidden" name="active" value="{{#if this.active}}0{{else}}1{{/if}}">
                                        <button type="submit" class="btn {{#if this.active}}btn-danger{{else}}btn-ghost{{/if}} btn-sm">
                                            {{#if this.active}}Desativar{{else}}Reativar{{/if}}
                                        </button>
                                    </form>
                                {{/if}}
                            </div>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="empty">
        <span class="empty-icon">{{icon "users"}}</span>
        <h2>Nenhum usuário encontrado</h2>
        <p>Nenhuma pessoa corresponde a essa busca.</p>
    </div>
    {{/if}}
</div>

{{#if history.length}}
<div class="card">
    <div class="card-head">
        <h2>{{icon "history"}} Histórico de alterações</h2>
        <span class="section-note">Últimas 15 mudanças de acesso</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Quando</th><th>Quem</th><th>Alterou</th><th>Mudança</th></tr>
            </thead>
            <tbody>
                {{#each history}}
                <tr>
                    <td class="nowrap"><small class="muted">{{formatDateTime this.created_at}}</small></td>
                    <td>{{this.actor_name}}</td>
                    <td>{{this.target_name}}</td>
                    <td>
                        {{#if (eq this.action 'papel')}}
                            <span class="badge badge-muted">{{this.from_type}}</span> →
                            <span class="badge badge-primary">{{this.to_type}}</span>
                        {{else}}
                            <span class="badge badge-warning">{{this.action}}</span>
                        {{/if}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}

{{#if viewerIsAdmin}}
    {{#each users}}
        {{#unless (eq this.id ../currentUser.id)}}
        <dialog id="modal-senha-{{this.id}}">
            <form method="POST" action="/vet/equipe/{{this.id}}/senha">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                <div class="modal-head">
                    <h2>{{icon "lock"}} Redefinir senha</h2>
                    <button type="button" class="modal-close" data-modal-close aria-label="Fechar">{{icon "close"}}</button>
                </div>
                <div class="modal-body">
                    <p class="modal-note">
                        Definir uma nova senha para <strong>{{this.name}}</strong>.
                        Todas as sessões dessa pessoa serão encerradas.
                    </p>
                    <div class="field">
                        <label for="pw-{{this.id}}">Nova senha</label>
                        <input type="password" id="pw-{{this.id}}" name="password" required minlength="8"
                               autocomplete="new-password">
                        <span class="hint">Mínimo de 8 caracteres. Combine a troca com a pessoa.</span>
                    </div>
                </div>
                <div class="modal-foot">
                    <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
                    <button type="submit" class="btn btn-primary">Redefinir</button>
                </div>
            </form>
        </dialog>
        {{/unless}}
    {{/each}}
{{/if}}
