<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles">
            <h1>Internações</h1>
            <div class="subtitle">
                {{hospitalizations.length}} {{#if (eq hospitalizations.length 1)}}registro{{else}}registros{{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <a href="/vet/consultas" class="btn {{#if (eq filtro 'todas')}}btn-primary{{else}}btn-ghost{{/if}}">Todas</a>
        <a href="/vet/consultas?filtro=abertas" class="btn {{#if (eq filtro 'abertas')}}btn-primary{{else}}btn-ghost{{/if}}">Em aberto</a>
        <a href="/vet/consultas?filtro=hoje" class="btn {{#if (eq filtro 'hoje')}}btn-primary{{else}}btn-ghost{{/if}}">Hoje</a>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h2>{{icon "hospital"}} Registro de internações</h2>
        <span class="section-note">
            {{#if (eq filtro 'abertas')}}Somente sem alta{{else}}{{#if (eq filtro 'hoje')}}Entradas de hoje{{else}}Todo o histórico{{/if}}{{/if}}
        </span>
    </div>
    {{#if hospitalizations.length}}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Animal</th><th>Entrada</th><th>Saída</th><th>Motivo</th>
                    <th>Diagnóstico</th><th>Responsável</th><th class="actions-cell"></th>
                </tr>
            </thead>
            <tbody>
                {{#each hospitalizations}}
                <tr>
                    <td>
                        <span class="cell-main">
                            {{speciesIcon this.species}}
                            <a href="/vet/animal/{{this.animal_id}}"><strong>{{this.animal_name}}</strong></a>
                        </span>
                        <small class="cell-sub">{{this.species}}</small>
                    </td>
                    <td class="nowrap">{{formatDate this.entry_date}}</td>
                    <td class="nowrap">
                        {{#if this.exit_date}}
                            {{formatDate this.exit_date}}
                            {{#if this.exit_status}}<small class="cell-sub">{{this.exit_status}}</small>{{/if}}
                        {{else}}
                            <span class="badge badge-warning badge-dot">Em aberto</span>
                        {{/if}}
                    </td>
                    <td>{{this.reason}}</td>
                    <td>{{#if this.diagnosis}}{{truncate this.diagnosis 80}}{{else}}—{{/if}}</td>
                    <td><small>{{#if this.vet_name}}{{this.vet_name}}{{else}}—{{/if}}</small></td>
                    <td class="actions-cell">
                        {{#unless this.exit_date}}
                        <button type="button" class="btn btn-primary btn-sm" data-modal-open="alta-{{this.id}}">
                            Dar alta
                        </button>
                        {{/unless}}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="empty">
        <span class="empty-icon">{{icon "hospital"}}</span>
        <h2>Nenhuma internação</h2>
        <p>
            {{#if (eq filtro 'todas')}}Nada registrado até agora.
            {{else}}Nenhum registro com esse filtro. <a href="/vet/consultas">Ver todas</a>.{{/if}}
        </p>
    </div>
    {{/if}}
</div>

{{#each hospitalizations}}
    {{#unless this.exit_date}}
    <dialog id="modal-alta-{{this.id}}">
        <form method="POST" action="/vet/internacao/{{this.id}}/alta">
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <div class="modal-head">
                <h2>{{icon "hospital"}} Dar alta — {{this.animal_name}}</h2>
                <button type="button" class="modal-close" data-modal-close aria-label="Fechar">{{icon "close"}}</button>
            </div>
            <div class="modal-body">
                <p class="modal-note">
                    Internado em {{formatDate this.entry_date}} — {{this.reason}}
                </p>
                <div class="form-row">
                    <div class="field">
                        <label for="saida-{{this.id}}">Data da alta</label>
                        <input type="date" id="saida-{{this.id}}" name="exit_date" data-default-today>
                    </div>
                    <div class="field">
                        <label for="st-{{this.id}}">Status após a alta</label>
                        <select id="st-{{this.id}}" name="animal_status">
                            <option value="abrigo">Abrigo</option>
                            <option value="clinica">Clínica</option>
                            <option value="adotado">Adotado</option>
                            <option value="falecido">Falecido</option>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="cond-{{this.id}}">Condição na alta</label>
                    <input type="text" id="cond-{{this.id}}" name="exit_status" maxlength="200"
                           placeholder="Ex.: recuperado, estável">
                </div>
                <div class="field">
                    <label for="obs-{{this.id}}">Observações finais</label>
                    <textarea id="obs-{{this.id}}" name="observations" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
                <button type="submit" class="btn btn-primary">Confirmar alta</button>
            </div>
        </form>
    </dialog>
    {{/unless}}
{{/each}}
