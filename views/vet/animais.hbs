<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles">
            <h1>Animais</h1>
            <div class="subtitle">
                {{animals.length}} {{#if (eq animals.length 1)}}resultado{{else}}resultados{{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <a href="/vet/cadastrar-animal" class="btn btn-primary">{{icon "plus"}} Cadastrar animal</a>
    </div>
</div>

{{#if ok}}
<div class="alert alert-success" role="status">
    {{icon "checkCircle"}}<span class="alert-body">{{ok}}</span>
</div>
{{/if}}

<div class="card">
    <div class="card-head">
        <h2>{{icon "filter"}} Filtros</h2>
        <a href="/vet/animais" class="btn btn-quiet btn-sm">Limpar</a>
    </div>
    <form method="GET" action="/vet/animais" class="filters">
        <div class="field">
            <label for="q">Buscar</label>
            <div class="search-field">
                {{icon "search"}}
                <input type="search" id="q" name="q" value="{{filtros.search}}" placeholder="Nome, raça ou chip">
            </div>
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status" data-autosubmit>
                <option value="">Todos</option>
                {{#each statuses}}
                <option value="{{this}}" {{selected this ../filtros.status}}>{{statusLabel this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="especie">Espécie</label>
            <select id="especie" name="especie" data-autosubmit>
                <option value="">Todas</option>
                {{#each especies}}
                <option value="{{this.species}}" {{selected this.species ../filtros.species}}>{{this.species}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="ambiente">Ambiente</label>
            <select id="ambiente" name="ambiente" data-autosubmit>
                <option value="">Todos</option>
                {{#each environments}}
                <option value="{{this.id}}" {{selected this.id ../filtros.ambiente}}>{{this.name}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="filtrar" class="muted">&nbsp;</label>
            <button type="submit" id="filtrar" class="btn btn-primary">{{icon "filter"}} Filtrar</button>
        </div>
    </form>
</div>

{{#if animals.length}}
<div class="grid">
    {{#each animals}}
        {{> animal-card animal=this href=(concat "/vet/animal/" this.id)}}
    {{/each}}
</div>
{{else}}
<div class="card">
    <div class="empty">
        <span class="empty-icon">{{icon "search"}}</span>
        <h2>Nenhum animal encontrado</h2>
        <p>Nenhum registro corresponde a esses filtros. Tente uma busca mais ampla.</p>
        <p class="mt"><a href="/vet/animais" class="btn btn-ghost">Limpar filtros</a></p>
    </div>
</div>
{{/if}}
