<div class="topbar">
    <div class="row">
        <button type="button" class="btn btn-ghost btn-icon menu-toggle" data-menu-toggle
                aria-expanded="false" aria-label="Abrir menu">☰</button>
        <div class="titles">
            <h1>Animais</h1>
            <div class="subtitle">
                {{animals.length}} {{#if (eq animals.length 1)}}resultado{{else}}resultados{{/if}}
            </div>
        </div>
    </div>
    <div class="actions">
        <a href="/vet/cadastrar-animal" class="btn btn-primary">+ Cadastrar animal</a>
    </div>
</div>

<div class="card">
    <form method="GET" action="/vet/animais" class="filters">
        <div class="field">
            <label for="q">Buscar</label>
            <input type="search" id="q" name="q" value="{{filtros.search}}" placeholder="Nome, raça ou chip">
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status" data-autosubmit>
                <option value="">Todos</option>
                {{#each statuses}}
                <option value="{{this}}" {{selected this ../filtros.status}}>{{statusLabel this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="especie">Espécie</label>
            <select id="especie" name="especie" data-autosubmit>
                <option value="">Todas</option>
                {{#each especies}}
                <option value="{{this.species}}" {{selected this.species ../filtros.species}}>{{this.species}}</option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label for="ambiente">Ambiente</label>
            <select id="ambiente" name="ambiente" data-autosubmit>
                <option value="">Todos</option>
                {{#each environments}}
                <option value="{{this.id}}" {{selected this.id ../filtros.ambiente}}>
                    {{kindIcon this.kind}} {{this.name}}
                </option>
                {{/each}}
            </select>
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <div class="row-tight">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a href="/vet/animais" class="btn btn-ghost">Limpar</a>
            </div>
        </div>
    </form>
</div>

{{#if animals.length}}
<div class="grid">
    {{#each animals}}
        {{> animal-card animal=this href=(concat "/vet/animal/" this.id)}}
    {{/each}}
</div>
{{else}}
<div class="card">
    <div class="empty">
        <span class="emoji" aria-hidden="true">🔍</span>
        <p>Nenhum animal encontrado com esses filtros.</p>
        <p class="mt"><a href="/vet/animais" class="btn btn-ghost">Limpar filtros</a></p>
    </div>
</div>
{{/if}}
