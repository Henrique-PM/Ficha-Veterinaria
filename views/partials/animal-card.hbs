<article class="animal-card">
    <div class="animal-photo"
         {{#if animal.has_photo}}style="background-image:url('/media/animal/{{animal.id}}/photo')"{{/if}}>
        {{#unless animal.has_photo}}{{speciesIcon animal.species}}{{/unless}}
        <span class="corner badge badge-dot badge-{{statusVariant animal.status}}">{{statusLabel animal.status}}</span>
    </div>

    <div class="animal-body">
        <div>
            <div class="animal-name">{{animal.name}}</div>
            <div class="animal-meta">
                {{speciesIcon animal.species}}
                <span>{{animal.species}} · {{#if animal.breed}}{{animal.breed}}{{else}}SRD{{/if}}</span>
            </div>
        </div>

        <div class="tags">
            <span class="tag">{{displayAge animal}}</span>
            {{#if animal.sex}}<span class="tag">{{animal.sex}}</span>{{/if}}
            {{#if animal.environment_name}}
                <span class="tag">{{kindIcon animal.environment_kind}} {{animal.environment_name}}</span>
            {{/if}}
            {{#if animal.neutered}}<span class="tag badge-success">Castrado</span>{{/if}}
            {{#if (eq animal.fiv_status 'positivo')}}<span class="tag badge-danger">FIV+</span>{{/if}}
            {{#if (eq animal.felv_status 'positivo')}}<span class="tag badge-danger">FeLV+</span>{{/if}}
        </div>

        <a href="{{href}}" class="btn btn-ghost btn-sm btn-block" style="margin-top:auto">
            {{#if @root.isVet}}Abrir ficha{{else}}Ver detalhes{{/if}}
        </a>
    </div>
</article>
