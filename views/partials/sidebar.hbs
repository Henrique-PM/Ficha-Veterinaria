<nav class="sidebar" aria-label="Menu principal">
    <a class="brand" href="/">
        <span class="brand-mark">{{icon "paw"}}</span>
        <span class="brand-text">
            <span class="brand-name">Ficha Veterinária</span>
            <span class="brand-sub">Prontuário</span>
        </span>
    </a>

    {{#if isVet}}
        <div class="nav-group-label">Operação</div>
        <a class="nav-link {{navActive currentPath '/vet/dashboard'}}" href="/vet/dashboard">
            {{icon "dashboard"}} Painel
        </a>
        <a class="nav-link {{navActive currentPath '/vet/animais'}}" href="/vet/animais">
            {{icon "paw"}} Animais
        </a>
        <a class="nav-link {{navActive currentPath '/vet/ambientes'}}" href="/vet/ambientes">
            {{icon "warehouse"}} Ambientes
        </a>
        <a class="nav-link {{navActive currentPath '/vet/alertas'}}" href="/vet/alertas">
            {{icon "bell"}} Alertas
        </a>

        <div class="nav-group-label">Clínica</div>
        <a class="nav-link {{navActive currentPath '/vet/consultas'}}" href="/vet/consultas">
            {{icon "hospital"}} Internações
        </a>
        <a class="nav-link {{navActive currentPath '/vet/medicamentos'}}" href="/vet/medicamentos">
            {{icon "pill"}} Medicamentos
        </a>
        <a class="nav-link {{navActive currentPath '/vet/relatorios'}}" href="/vet/relatorios">
            {{icon "chart"}} Relatórios
        </a>
        <a class="nav-link {{navActive currentPath '/vet/meus-registros'}}" href="/vet/meus-registros">
            {{icon "clipboard"}} Meus registros
        </a>

        {{#if isRoot}}
        <div class="nav-group-label">Administração</div>
        <a class="nav-link {{navActive currentPath '/vet/equipe'}}" href="/vet/equipe">
            {{icon "users"}} Equipe
            <span class="count count-soft">root</span>
        </a>
        {{/if}}
    {{else}}
        <div class="nav-group-label">Abrigo</div>
        <a class="nav-link {{navActive currentPath '/user/dashboard'}}" href="/user/dashboard">
            {{icon "paw"}} Animais
        </a>
    {{/if}}

    <div class="sidebar-foot">
        <div class="user-chip">
            <div class="avatar" aria-hidden="true">{{initials currentUser.name}}</div>
            <div class="who">
                <strong>{{currentUser.name}}</strong>
                <small>{{#if isRoot}}Administrador{{else}}{{#if isVet}}Veterinário{{else}}Visualizador{{/if}}{{/if}}</small>
            </div>
        </div>
        <div class="row-tight">
            <a href="/auth/senha" class="btn btn-ghost btn-sm grow">{{icon "lock"}} Senha</a>
            <form method="POST" action="/auth/logout" class="grow">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button type="submit" class="btn btn-ghost btn-sm btn-block">{{icon "logout"}} Sair</button>
            </form>
        </div>
    </div>
</nav>
