<div class="topbar">
    <div class="row">
        {{> menu-button}}
        <div class="titles"><h1>{{title}}</h1></div>
    </div>
</div>

<div class="card">
    <div class="empty">
        <span class="empty-icon">
            {{#if (eq code 403)}}{{icon "lock"}}{{else}}{{#if (eq code 404)}}{{icon "search"}}{{else}}{{icon "alert"}}{{/if}}{{/if}}
        </span>
        <h2>Erro {{code}}</h2>
        <p>{{message}}</p>
        <p class="mt">
            <a href="{{#if backUrl}}{{backUrl}}{{else}}/{{/if}}" class="btn btn-primary">{{icon "arrowLeft"}} Voltar</a>
        </p>
    </div>
</div>
