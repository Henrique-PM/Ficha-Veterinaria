<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-head">
            <div class="logo" aria-hidden="true">🐾</div>
            <h1>Criar conta</h1>
            <p>Ficha Veterinária</p>
        </div>

        {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}

        <form action="/auth/register" method="POST">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">

            <div class="field">
                <label for="name">Nome completo</label>
                <input type="text" id="name" name="name" value="{{form.name}}" required autofocus autocomplete="name">
            </div>

            <div class="field">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" value="{{form.email}}" required autocomplete="email">
            </div>

            <div class="field">
                <label for="password">Senha</label>
                <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
                <span class="hint">Mínimo de 8 caracteres.</span>
            </div>

            <div class="alert alert-info">
                Toda conta nova entra como <strong>visualizador</strong>, com acesso apenas à
                apresentação dos animais. O acesso a prontuários é liberado pela equipe
                veterinária depois do cadastro.
            </div>

            <button type="submit" class="btn btn-primary btn-block">Criar conta</button>
        </form>

        <div class="auth-foot">
            Já tem conta? <a href="/auth/login">Fazer login</a>
        </div>
    </div>
</div>
